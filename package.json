{
  "name": "simple-live-tally",
  "version": "1.16.0",
  "private": true,
  "description": "Serverless, BYOS fundraising/voting tally display. Dev tooling only — the deployed app is the static index.html + css/js files.",
  "scripts": {
    "test": "node --test",
    "build:css": "tailwindcss -i css/input.css -o css/tailwind.css --minify",
    "lint": "eslint .",
    "format": "prettier --write \"js/**/*.js\" \"test/**/*.js\" eslint.config.js",
    "format:check": "prettier --check \"js/**/*.js\" \"test/**/*.js\" eslint.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.1"
  }
}
